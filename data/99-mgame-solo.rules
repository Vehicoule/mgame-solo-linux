# M-Audio M-Game Solo RawMIDI and USB Device Permissions
# Grants non-root users direct hardware control access for streaming/mixer software

SUBSYSTEM=="sound", ATTRS{idVendor}=="0763", ATTRS{idProduct}=="0043", TAG+="uaccess"
SUBSYSTEM=="usb", ATTRS{idVendor}=="0763", ATTRS{idProduct}=="0043", TAG+="uaccess", MODE="0660", GROUP="audio"
KERNEL=="midiC*D*", ATTRS{idVendor}=="0763", ATTRS{idProduct}=="0043", TAG+="uaccess", MODE="0660", GROUP="audio"
